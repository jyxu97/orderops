# Only needed for the split-origin deployment (S3/CloudFront for the app, a separate ALB
# hostname for the API). Leave both unset when CloudFront fronts the API too, or in local
# development where Vite proxies them — the app then uses relative URLs.
# VITE_API_BASE_URL=https://api.example.com
# VITE_WS_URL=wss://api.example.com/ws

# Override the API the Vite dev server proxies to.
# VITE_DEV_API_TARGET=http://localhost:8080
